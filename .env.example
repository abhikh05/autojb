# ─── REQUIRED ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── EMAIL (Gmail App Password) ─────────────────────────────
# Go to myaccount.google.com → Security → App Passwords → Create one
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ─── JOB SEARCH API (free tier available) ───────────────────
# Sign up at rapidapi.com → search "JSearch" → subscribe free tier
JSEARCH_API_KEY=your-jsearch-key-here

# ─── APP CONFIG ─────────────────────────────────────────────
PORT=3000
# Auto-run pilot every N hours (0 = disabled, run manually only)
AUTO_RUN_INTERVAL_HOURS=0
